# Supabase (Project Settings -> API): URL and anon key are public, service role key is server-only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, for running schema.sql
DATABASE_URL=

# n8n webhook trigger URL and shared secret (same value on both sides)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Public URL of this app, used by n8n for the result callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider key, configured in n8n credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
